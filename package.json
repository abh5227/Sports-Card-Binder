{
	"name": "sports-card-binder",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "A personal sports-card collection app with a binder interface.",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite",
		"dev:server": "node --watch server/index.ts",
		"build": "vite build",
		"start": "node server/index.ts",
		"typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@fastify/static": "^10.1.3",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.12.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@playwright/test": "^1.62.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.2.0",
		"drizzle-kit": "^0.31.10",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"typescript": "~6.0.3",
		"vite": "^8.2.1",
		"vitest": "^4.1.11"
	}
}
