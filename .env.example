# Copy to .env and adjust. .env is git-ignored; this example is not.
#
# Where the collection lives: the SQLite database, cached card images, exports.
# MUST be outside this repository — the repo is public, the collection is not.
#
# macOS: do NOT point this at ~/Documents or ~/Desktop. Both are live iCloud
# file-provider domains on this machine, and sync interleaving with SQLite's WAL
# checkpointing — or eviction under Optimize Mac Storage — can corrupt a live
# database. Backups belong in iCloud; the working database does not. See CLAUDE.md.
BINDER_DATA_DIR=~/Developer/binder-data

# API server bind. The frontend dev server proxies /api here.
PORT=8787
HOST=127.0.0.1
