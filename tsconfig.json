{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["node", "vite/client"],

		// The server runs straight from source: `node server/index.ts`. Node 24 strips
		// types, it does not compile them, so any syntax needing a real transform
		// (enum, namespace, parameter properties) would fail at runtime. These two
		// options make the compiler reject that syntax instead, so the guarantee is
		// checked rather than remembered.
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,

		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"exactOptionalPropertyTypes": true,

		"noEmit": true,
		"skipLibCheck": true,
		"resolveJsonModule": true
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "server/**/*.ts", "tests/**/*.ts", "*.config.ts"]
}
